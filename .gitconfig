[user]
	name = Vyygir
	email = open.source@vyygir.me
[core]
	excludesfile = /home/vyygir/.config/.gitignore_global
	editor = hx
	pager = delta
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
	navigate = true
	dark = true
[alias]
	stat = !git-st
	hot-paths = !git log --format=format: --name-only --since=\"1 year ago\" | sort | uniq -c | sort -nr | head -20
	lead = shortlog -sn --no-merges
	clusters = !git log -i -E --grep=\"fix|bug|broken\" --name-only --format='' | sort | uniq -c | sort -nr | head -20
	firefight = !git log --oneline --since=\"1 year ago\" | grep -iE 'revert|hotfix|emergency|rollback'
[init]
	defaultBranch = main
