{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logos/cake.txt",
        "type": "file",
        "padding": {
            "top": 1
        },
        "color": {
            "1": "38;2;138;103;13"
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
          "type": "custom",
          "key": "\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc",
          "keyColor": "38;2;138;103;13" 
        },
        {
          "type": "title",
          "outputColor": "white",
          "format": "{user-name} {home-dir}",
          "key": "\ue602 PRFIL \uf2bd ",
          "keyColor": "38;2;138;103;13",
        },
        // Separator
        {
          "type": "custom",
          "key": "\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc",
          "keyColor": "38;2;138;103;13" 
        },
        //
        {
          "type": "cpu",
          "outputColor": "white",
          "format": "",
          "key": "\ue602 PROCS \uf4bc ",
          "keyColor": "38;2;138;103;13",
        },
        {
          "type": "gpu",
          "outputColor": "white",
          "format": "",
          "key": "\ue602 GRAPH \udb80\ude97 ",
          "keyColor": "38;2;138;103;13",
        },
        {
          "type": "memory",
          "outputColor": "white",
          "format": "",
          "key": "\ue602 MEMRY \uefc5 ",
          "keyColor": "38;2;138;103;13",
        },
        // Separator
        {
          "type": "custom",
          "key": "\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc",
          "keyColor": "38;2;138;103;13" 
        },
        //
        {
          "type": "os",
          "outputColor": "white",
          "format": "{pretty-name}",
          "key": "\ue602 OPSYS \udb81\udc93 ",
          "keyColor": "38;2;138;103;13",
        },
        // Separator
        {
          "type": "custom",
          "key": "\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc",
          "keyColor": "38;2;138;103;13" 
        },
        //
        {
          "type": "display",
          "outputColor": "white",
          "format": "{inch}\" {refresh-rate}Hz {width}x{height} {name}",
          "key": "\ue602 DISPY \udb80\udf79 ",
          "keyColor": "38;2;138;103;13"
        },
        // Separator
        {
          "type": "custom",
          "key": "\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc\ueacc",
